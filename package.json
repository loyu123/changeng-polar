{
  "name": "changeng-polar",
  "version": "0.8.0",
  "private": true,
  "description": "长庚 · 本地电脑管家（对话驱动，写操作全部穿授权闸门）",
  "author": "loyu123",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "eval": "tsx scripts/eval.ts",
    "rejudge": "tsx scripts/rejudge.ts",
    "smoke": "tsx scripts/smoke.ts",
    "gate": "tsx scripts/gate-check.ts",
    "orchestrate": "tsx scripts/orchestrator-demo.ts",
    "orchestrate:parallel": "tsx scripts/orchestrator-parallel.ts",
    "delegate": "tsx scripts/delegate-smoke.ts",
    "project": "tsx scripts/project-smoke.ts",
    "backends": "tsx scripts/backends-check.ts",
    "backends:work": "tsx scripts/backends-work.ts",
    "mixed": "tsx scripts/mixed-backends.ts",
    "github": "tsx scripts/github-smoke.ts",
    "mock": "node scripts/mock-llm.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "imapflow": "^2.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "//overrides": "minimatch 强推到 11.x：9.0.9（@electron/universal）与 10.2.6（app-builder-lib）都落在 GHSA-g3hv-75wg-m249 的受影响区间（>=7.0.0 <11.0.1）。electron-builder 26.18.0 已是当前最新，上游还没升；npm audit 给的办法是把它降级到 25.1.0——更旧、牵扯更多，不能听。改这里必须跑一次 npm run pack:dir。",
  "//overrides-dir-compare": "例外：dir-compare 要的是 minimatch ^3 的老 API（它只做目录比对，不碰打包文件列表）。@electron/universal 那条会连子树一起压，所以这里把 dir-compare 单独放回去——不这么做 npm ls 会直接报 invalid。",
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.7"
    },
    "@electron/universal": {
      "minimatch": "^11.0.7"
    },
    "dir-compare": {
      "minimatch": "^3.1.2"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.loyu123.changengpolar",
    "productName": "长庚POLAR",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "changgeng-polar-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "长庚POLAR",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "changgeng-polar-${version}-portable.${ext}"
    }
  }
}
